# Slack app installed from manifest.json; never commit real tokens.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# App Home destination; invite the bot to this channel first (C... or G...).
SLACK_NOTIFICATION_CHANNEL=
# Used for next-week calculations. Change for your operating timezone.
TZ=Asia/Seoul

# Optional scheduling preferences (environment overrides config.json).
START_HOUR=10
END_HOUR=18
INTERVIEW_MINUTES=60
OPTION_COUNT=6
