# 공통 Slack 설정 — 두 앱 모두 같은 이름을 사용합니다.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 게시할 채널 ID. 회의실 앱은 선택, 면접 앱은 필수입니다.
SLACK_NOTIFY_CHANNEL=
APP_TIMEZONE=Asia/Seoul
# 상대 경로는 저장소 루트 기준. 두 앱의 DB는 별도로 둡니다.
SQLITE_PATH=./data/availability.sqlite

# 면접 앱 전용 설정
# Optional scheduling preferences (environment overrides config.json).
START_HOUR=10
END_HOUR=18
INTERVIEW_MINUTES=60
OPTION_COUNT=6

# 기존 Mac 키체인을 명시적으로 쓸 때만 설정 (기본은 env).
# SLACK_TOKEN_SOURCE=keychain
